# Supabase project used for the `leads` CRM table (see db/schema.sql).
# Can be the same project as solen-backend, or a dedicated one.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Used for scoring leads and drafting outreach.
ANTHROPIC_API_KEY=

# Niche search via Serper.dev (Google search results API). Sign up at
# https://serper.dev — free credits on signup, no card required.
SERPER_API_KEY=

# SMTP account used to send outreach — any real mailbox works (Hostinger,
# Gmail with an App Password, etc). Check your provider's "email client
# configuration" / "manual setup" page for the exact host/port.
# Hostinger typically: host smtp.hostinger.com, port 465.
# Gmail typically: host smtp.gmail.com, port 465, password = an App Password
# from https://myaccount.google.com/apppasswords (not your login password).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional — defaults to SMTP_USER if not set. Useful if you want a display
# name, e.g. "VERZO Studio <hello@verzo.studio>".
SMTP_FROM=

# Optional — signature appended to every sent email, before the opt-out
# footer. Defaults to Thomas's signature (see src/mailer.js) if not set —
# only set this to override it. Paste real line breaks into the value.
EMAIL_SIGNATURE=

# Raw SMTP submission never writes to any "Sent" folder on its own — every
# sent email is BCC'd here so it's actually visible somewhere. Defaults to
# SMTP_USER (the sending mailbox itself) if not set.
SENT_COPY_TO=

# Optional — set EMAIL_TEMPLATE_BODY to use a fixed template (variable
# substitution only) instead of AI-generated outreach copy. Available
# placeholders: {{company}} {{domain}} {{opportunity}} {{business_trigger}}
# {{decision_maker}} {{role}}. If EMAIL_TEMPLATE_BODY is unset, the pipeline
# falls back to Claude-drafted outreach (src/draft.js) as before.
EMAIL_TEMPLATE_SUBJECT=
EMAIL_TEMPLATE_BODY=
LINKEDIN_TEMPLATE=

# Minimum score (0-100) for a lead to get a drafted email at all (see
# pipeline.js). Leads below this stay NEW with no draft.
MIN_SCORE_FOR_OUTREACH=70

# Auto-send guardrails (see src/mailer.js). Leads scoring >= this go out
# automatically, no human click required. Drafted leads scoring below this
# (but >= MIN_SCORE_FOR_OUTREACH) wait for a manual click — either
# POST /leads/:id/approve (goes out on the next auto-send pass) or the
# dashboard's "Envoyer maintenant" button (POST /leads/:id/send-now, sends
# immediately, bypasses the hourly/daily caps since it's a one-off human call).
AUTO_SEND_MIN_SCORE=85

# Rate caps protecting sender reputation — a brand-new sending domain should
# ramp these up gradually rather than start at target volume. See README
# "Montée en charge" for a suggested weekly schedule toward ~15/h (150/day).
# These defaults are deliberately conservative for week 1.
DAILY_SEND_LIMIT=25
HOURLY_SEND_LIMIT=5

# Shared secret required (as `x-verzo-secret` header, or `Authorization: Bearer <VERZO_SECRET>`)
# to hit /run, /leads, /leads/:id/approve, /send-approved.
VERZO_SECRET=change-me

# Separate secret for the scheduled cron trigger (GET /cron/run). Scheduling
# is done via GitHub Actions (.github/workflows/hourly-outreach.yml), which
# sends this as `Authorization: Bearer <CRON_SECRET>` — add the same value
# as a repo secret named CRON_SECRET in GitHub (Settings > Secrets and
# variables > Actions), in addition to setting it here in Vercel.
CRON_SECRET=change-me-too

# Search queries the hourly cron rotates through (comma-separated) — one is
# picked at random each run. Use this instead of the singular
# DEFAULT_NICHE_QUERY below to cover multiple cities/niches rather than
# over-fitting to one city (also needed to sustain enough volume for 15/h).
DEFAULT_NICHE_QUERIES="cabinet de recrutement Paris,cabinet de recrutement Lyon,cabinet de recrutement Bordeaux,cabinet de recrutement Lille,cabinet de recrutement Marseille,cabinet de recrutement Nantes,cabinet de recrutement Toulouse"

# Fallback used only if DEFAULT_NICHE_QUERIES is unset.
DEFAULT_NICHE_QUERY="cabinet de recrutement Paris"

PORT=3001
