# Supabase project used for the `leads` CRM table (see db/schema.sql).
# Can be the same project as solen-backend, or a dedicated one.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Used for scoring leads and drafting outreach.
ANTHROPIC_API_KEY=

# Niche search via Google Programmable Search Engine (100 free queries/day,
# no billing/card required). Create a search engine (enable "search the
# entire web") at https://programmablesearchengine.google.com/controlpanel/create
# for CSE, and an API key (enable "Custom Search API" first) at
# https://console.cloud.google.com/apis/credentials
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# Gmail account used to send outreach (App Password, not your login password
# — generate one at https://myaccount.google.com/apppasswords, requires 2FA
# enabled on the account).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Auto-send guardrails (see src/mailer.js). Leads scoring >= this go out
# automatically, no human click required. Lower-scoring qualified leads still
# need POST /leads/:id/approve. Daily cap protects sender reputation.
AUTO_SEND_MIN_SCORE=85
DAILY_SEND_LIMIT=10

# Shared secret required (as `x-verzo-secret` header, or `Authorization: Bearer <VERZO_SECRET>`)
# to hit /run, /leads, /leads/:id/approve, /send-approved.
VERZO_SECRET=change-me

# Separate secret for the scheduled cron trigger (GET /cron/run). Name it
# exactly CRON_SECRET in Vercel's project settings — Vercel then automatically
# sends `Authorization: Bearer <CRON_SECRET>` on cron invocations, no extra
# config needed. See vercel.json.
CRON_SECRET=change-me-too

# Default search query used by the scheduled cron trigger, since cron
# requests can't carry a body.
DEFAULT_NICHE_QUERY="cabinet de recrutement Paris"

PORT=3001
