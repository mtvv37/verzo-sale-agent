# Supabase project used for the `leads` CRM table (see db/schema.sql).
# Can be the same project as solen-backend, or a dedicated one.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Used for scoring leads and drafting outreach.
ANTHROPIC_API_KEY=

# Niche search via Serper.dev (Google search results API). Sign up at
# https://serper.dev — free credits on signup, no card required.
SERPER_API_KEY=

# SMTP account used to send outreach — any real mailbox works (Hostinger,
# Gmail with an App Password, etc). Check your provider's "email client
# configuration" / "manual setup" page for the exact host/port.
# Hostinger typically: host smtp.hostinger.com, port 465.
# Gmail typically: host smtp.gmail.com, port 465, password = an App Password
# from https://myaccount.google.com/apppasswords (not your login password).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional — defaults to SMTP_USER if not set. Useful if you want a display
# name, e.g. "VERZO Studio <hello@verzo.studio>".
SMTP_FROM=

# Optional — signature appended to every sent email, before the opt-out
# footer. Defaults to Thomas's signature (see src/mailer.js) if not set —
# only set this to override it. Paste real line breaks into the value.
EMAIL_SIGNATURE=

# Optional — set EMAIL_TEMPLATE_BODY to use a fixed template (variable
# substitution only) instead of AI-generated outreach copy. Available
# placeholders: {{company}} {{domain}} {{opportunity}} {{business_trigger}}
# {{decision_maker}} {{role}}. If EMAIL_TEMPLATE_BODY is unset, the pipeline
# falls back to Claude-drafted outreach (src/draft.js) as before.
EMAIL_TEMPLATE_SUBJECT=
EMAIL_TEMPLATE_BODY=
LINKEDIN_TEMPLATE=

# Auto-send guardrails (see src/mailer.js). Leads scoring >= this go out
# automatically, no human click required. Lower-scoring qualified leads still
# need POST /leads/:id/approve. Daily cap protects sender reputation.
AUTO_SEND_MIN_SCORE=85
DAILY_SEND_LIMIT=10

# Shared secret required (as `x-verzo-secret` header, or `Authorization: Bearer <VERZO_SECRET>`)
# to hit /run, /leads, /leads/:id/approve, /send-approved.
VERZO_SECRET=change-me

# Separate secret for the scheduled cron trigger (GET /cron/run). Name it
# exactly CRON_SECRET in Vercel's project settings — Vercel then automatically
# sends `Authorization: Bearer <CRON_SECRET>` on cron invocations, no extra
# config needed. See vercel.json.
CRON_SECRET=change-me-too

# Default search query used by the scheduled cron trigger, since cron
# requests can't carry a body.
DEFAULT_NICHE_QUERY="cabinet de recrutement Paris"

PORT=3001
