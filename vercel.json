{
  "version": 2,
  "builds": [
    { "src": "src/index.js", "use": "@vercel/node", "config": { "maxDuration": 60 } }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "src/index.js" }
  ],
  "functions": {
    "src/index.js": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/cron/run", "schedule": "0 7 * * 1-5" }
  ]
}
